# Sanity project connection for the Resources section (Blog, Case Studies,
# Documentation, Help Center). The dataset is publicly readable, so no API
# token is needed for reads — these two vars are optional; the app falls
# back to the values below if unset.
NEXT_PUBLIC_SANITY_PROJECT_ID=yvjlgkpi
NEXT_PUBLIC_SANITY_DATASET=production

# Google Analytics 4 measurement ID. Optional — defaults to the production
# property (G-M1V15MW8B4). Set it to an empty string to disable analytics
# entirely, e.g. on preview deployments.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-M1V15MW8B4

# SMTP credentials for the contact form. For Gmail/Google Workspace, use an
# App Password (not the account password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hello@easternfulfillment.com
SMTP_PASS="niey rtdj tgfj ckby"

# Where contact form notifications are delivered (defaults to SMTP_USER).
CONTACT_TO_EMAIL=hello@easternfulfillment.com
